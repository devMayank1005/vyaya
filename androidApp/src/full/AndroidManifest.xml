<?xml version="1.0" encoding="utf-8"?>
<!-- The full build only: reads SMS itself. Not for the Play Store (SMS permissions are for default SMS apps there). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <application>
        <!-- Exported for the system's broadcast; BROADCAST_SMS is held only by the system, so no app can fake one. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
