<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SEC-003: Android 11+ hides other apps unless named here; the listed UPI and bank apps are checked to be the real
         ones. Kept equal to UpiApps.default by AppVerifierTest. -->
    <queries>
        <package android:name="com.phonepe.app" />
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="net.one97.paytm" />
        <package android:name="in.org.npci.upiapp" />
        <package android:name="in.amazon.mShop.android.shopping" />
        <package android:name="com.dreamplug.androidapp" />
        <package android:name="com.mobikwik_new" />
        <package android:name="com.freecharge.android" />
        <package android:name="com.naviapp" />
        <package android:name="com.popclub.android" />
        <package android:name="money.super.payments" />
        <package android:name="money.jupiter" />
        <package android:name="indwin.c3.shareapp" />
        <package android:name="com.nextbillion.groww" />
        <package android:name="in.gokiwi.kiwitpap" />
        <package android:name="com.myairtelapp" />
        <package android:name="in.jfs.jiofinance" />
        <package android:name="com.sbi.lotusintouch" />
        <package android:name="com.sbi.upi" />
        <package android:name="com.hdfcbank.android.now" />
        <package android:name="com.hdfcbank.payzapp" />
        <package android:name="com.csam.icici.bank.imobile" />
        <package android:name="com.axis.mobile" />
        <package android:name="com.kotak.bank.mobile" />
        <package android:name="com.kotak811mobilebankingapp.instantsavingsupiscanandpayrecharge" />
        <package android:name="com.bankofbaroda.mconnect" />
        <package android:name="com.Version1" />
        <package android:name="com.idfcfirstbank.optimus" />
        <package android:name="com.indusind.indie" />
        <package android:name="in.irisbyyes.app" />
        <package android:name="com.fedmobile" />
    </queries>

    <!-- Budget alerts (budgets report #2); asked for on Android 13+ when the first budget is saved. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".VyayaApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- singleTop: an intent to open it (the widget, the tile, another app) reuses the screen on top rather than
             stacking another copy (launch report PEN-001). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only the system (holding BIND_NOTIFICATION_LISTENER_SERVICE) can bind it; the user grants access in settings. -->
        <service
            android:name=".CaptureListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Home-screen widget: the launcher must reach it, so it is exported; it only redraws itself, and only this
             app's placed widgets, whatever a sender names (QuickAddWidget). -->
        <receiver
            android:name=".QuickAddWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Widget report #1: a new day or zone redraws it. Protected broadcasts: only the system sends them. -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_widget_info" />
        </receiver>

        <!-- Quick Settings tile: only the system (holding BIND_QUICK_SETTINGS_TILE) can bind it. -->
        <service
            android:name=".QuickAddTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_add"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
