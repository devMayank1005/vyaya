<?xml version="1.0" encoding="utf-8"?>
<!-- SEC-007 (reports/core-data-2026-11-04.md), rule 8.8: the database (payees, notes, UPI references) never leaves the
     phone through Google's cloud backup or a device-to-device transfer. Users move data with Vyaya's own backup file. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
